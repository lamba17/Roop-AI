# Copy this file to .env.local and fill in your keys

# Supabase Auth & Database
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_WEBHOOK_SECRET=your-webhook-secret-here

# Anthropic AI (Claude Vision API)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Payments
VITE_RAZORPAY_KEY_ID=rzp_live_...
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemon-squeezy-webhook-secret

# Email & CRM (Brevo)
BREVO_LOGIN=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-password
BREVO_API_KEY=your-brevo-api-key-here
GMAIL_FROM=your-sender-email@gmail.com
